<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标 · 背景层。
  自适应图标固定 108×108，四周各 18dp 会被系统按机型裁掉，
  所以底色必须铺满（不能只画中间），否则换个启动器就露白边。
  渐变用 aapt:attr 内联，需要 API 24+；本项目 minSdk 26，安全。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF66B2F2" />
                <item android:offset="1" android:color="#FF2C74C9" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
