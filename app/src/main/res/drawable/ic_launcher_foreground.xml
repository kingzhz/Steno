<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标 · 前景层：一页折角的纸。

  几何：x 28..80、y 21..87，落在自适应图标的 72×72 安全区内，
  任何机型的遮罩都不会切到它。

  折角画成浅蓝而不是白色 —— 白色叠在白色纸面上等于看不见，
  浅蓝才读得出「这一角翻折过来了」。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 纸页本体：右上角斜切，其余三角圆角 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M28,28 a7,7 0 0 1 7,-7 h29 l16,16 v43 a7,7 0 0 1 -7,7 h-38 a7,7 0 0 1 -7,-7 z" />
    <!-- 翻折的那一角 -->
    <path
        android:fillColor="#FFD6E8FA"
        android:pathData="M64,21 l16,16 h-16 z" />
</vector>
