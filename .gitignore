*.iml
.gradle
/local.properties
/.idea
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
local.properties
*.apk

# —— 签名密钥：绝不进仓库 ——
# 丢了密钥 = 永远无法给已装用户推更新（换密钥必须卸载重装，旧数据全丢）。
# 泄露了密钥 = 任何人都能伪造这个 App 的「正版」更新包。
*.keystore
*.jks
*.p12
# 含 storePassword / keyPassword 的明文配置。
keystore.properties
# 只放行 SDK 自带的 debug 密钥（不是我们的，公开无妨）
!debug.keystore

# 端到端自检脚本（tools/buddy-*.mjs）读的账号凭据，含真实 access/refresh token。
credential-*.json

# —— 工作残留，不进仓库 ——
# 改主题前的文件备份（含历史版本源码）
_backup/
# 会话临时粘贴的大段文本
pastes/
# 本机 DSH 工具的会话数据
.dsh/
.kotlin/
# 图标探针产出的临时截图
.probe-look.png
# 脚本事故产物：%SystemDrive% 未被展开，Windows 字体缓存被写进了这个字面目录
%SystemDrive%/

# 构建产物（任意层级的 build 目录，例如 app/build）
build/
# 本机工具状态
.local/
# 探针脚本产物
*.probe-look.png
